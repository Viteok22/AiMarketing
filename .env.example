# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Если api.telegram.org недоступен напрямую, укажите локальный HTTP-прокси:
# TELEGRAM_PROXY=http://127.0.0.1:10809
TELEGRAM_PROXY=
ADMIN_TELEGRAM_ID=

# Веб-панель
ADMIN_PASSWORD=change-me
APP_SECRET_KEY=change-me-too
DATABASE_PATH=./data/app.db
APP_HOST=127.0.0.1
APP_PORT=8000

# DeepSeek API (текст)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# anymodel: генерация изображений (GPT Image 2.5)
ANYMODEL_BASE_URL=https://anymodel.org/v1
ANYMODEL_API_KEY=
ANYMODEL_IMAGE_MODEL=gpt-image-2.5
ANYMODEL_IMAGE_QUALITY=low

# ChatGPT в браузере (опционально, сейчас не используется)
CHATGPT_PROFILE_DIR=./data/chrome-profile
CHATGPT_HEADLESS=false
CHATGPT_URL=https://chatgpt.com/
